{
  "schemaVersion": 1,
  "id": "io.github.startupfoundry.hall-keys",
  "name": "Hall Keys",
  "version": "0.1.0",
  "author": "Paul Hontz",
  "license": "MIT",
  "description": "Profile switching, device info, and theme-matched lighting for Wooting Hall-effect keyboards in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Hall Keys",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollInterval": 20,
      "showProfileLabel": true,
      "themeLighting": false,
      "profile1Name": "",
      "profile2Name": "",
      "profile3Name": "",
      "profile4Name": ""
    },
    "schema": [
      {
        "key": "showProfileLabel",
        "type": "boolean",
        "label": "Show profile label",
        "description": "Show the active profile next to the keyboard icon on the bar.",
        "defaultValue": true
      },
      {
        "key": "themeLighting",
        "type": "boolean",
        "label": "Theme lighting",
        "description": "Paint the keyboard in the current Omarchy theme's keyboard color and re-apply on theme change.",
        "defaultValue": false
      },
      {
        "key": "pollInterval",
        "type": "number",
        "label": "Poll interval (seconds)",
        "description": "How often to ask the keyboard for its active profile.",
        "defaultValue": 20
      },
      {
        "key": "profile1Name",
        "type": "string",
        "label": "Profile 1 name",
        "description": "Optional label for onboard profile 1.",
        "defaultValue": ""
      },
      {
        "key": "profile2Name",
        "type": "string",
        "label": "Profile 2 name",
        "description": "Optional label for onboard profile 2.",
        "defaultValue": ""
      },
      {
        "key": "profile3Name",
        "type": "string",
        "label": "Profile 3 name",
        "description": "Optional label for onboard profile 3.",
        "defaultValue": ""
      },
      {
        "key": "profile4Name",
        "type": "string",
        "label": "Profile 4 name",
        "description": "Optional label for onboard profile 4.",
        "defaultValue": ""
      }
    ]
  }
}
